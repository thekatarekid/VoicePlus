<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FALLBACK ONLY. make_app.sh prefers App/Resources/Info.plist when it exists
  (it does), so this file is used only if the App module's plist is missing.
  Keep the NS*UsageDescription block identical to App/Resources/Info.plist —
  make_app.sh fails the build if any required key is missing from the result.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>VoicePlus</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>in.adityakatare.voiceplus</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>VoicePlus</string>
    <key>CFBundleDisplayName</key>
    <string>VoicePlus</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD__</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Aditya Katare. All rights reserved.</string>

    <!-- TCC usage descriptions — see App/Resources/Info.plist for the annotated list.
         Input Monitoring and Screen Recording have no usage-description key. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>VoicePlus listens only while you hold the dictation key. Audio is transcribed on this Mac and is never uploaded.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>VoicePlus uses Apple's on-device speech recognizer to turn your dictation into text. Recognition stays on this Mac.</string>
    <key>NSContactsUsageDescription</key>
    <string>VoicePlus reads the names in your contacts so it spells people's names correctly when you dictate them. Names never leave this Mac.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>VoicePlus checks your calendar for a meeting happening right now so it can offer to take notes. Event details stay on this Mac.</string>
    <key>NSCalendarsUsageDescription</key>
    <string>VoicePlus checks your calendar for a meeting happening right now so it can offer to take notes. Event details stay on this Mac.</string>
    <key>NSCameraUsageDescription</key>
    <string>VoicePlus only checks whether some other app has your camera switched on, as a hint that you are in a meeting. It never opens the camera or reads any video.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>VoicePlus sends your dictated text to whichever app you are typing into.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>VoicePlus uses Accessibility to read your cursor position and insert dictated text into the app you are using.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>VoicePlus opens a listener on this Mac's loopback address only, to receive the sign-in redirect when you connect a cloud account. Nothing is sent over your network.</string>

    <key>SUFeedURL</key>
    <string>https://updates.adityakatare.in/voiceplus/appcast.xml</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
</dict>
</plist>
