<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleExecutable</key><string>VoicePlus</string>
	<key>CFBundleIdentifier</key><string>in.adityakatare.voiceplus</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>VoicePlus</string>
	<key>CFBundleDisplayName</key><string>VoicePlus</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleIconFile</key><string>AppIcon</string>
	<!-- make_app.sh substitutes both __VERSION__/__BUILD__ and ${VERSION}/${BUILD}. -->
	<key>CFBundleShortVersionString</key><string>__VERSION__</string>
	<key>CFBundleVersion</key><string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key><string>15.0</string>
	<key>LSUIElement</key><true/>
	<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSHumanReadableCopyright</key><string>Copyright © 2026 Aditya Katare. All rights reserved.</string>

	<!-- ===================================================================
	     TCC usage descriptions.
	     Every protected API the app links MUST have its key here: macOS kills
	     the process (or silently refuses the prompt) when a usage string is
	     missing, which reads to the user as "no permission prompt appeared".
	     Keep this list in sync with Packaging/Info.plist.template; make_app.sh
	     fails the build if any of these keys is absent from the built bundle.

	     NOTE: Input Monitoring (kTCCServiceListenEvent) and Screen Recording
	     have NO Info.plist usage-description key — they are gated purely on the
	     code signature. See Packaging/SIGNING.md.
	     =================================================================== -->

	<!-- AVCaptureDevice / AVAudioEngine — App/Services/PipelineAudioSource.swift -->
	<key>NSMicrophoneUsageDescription</key>
	<string>VoicePlus listens only while you hold the dictation key. Audio is transcribed on this Mac and is never uploaded.</string>

	<!-- SFSpeechRecognizer (on-device) — Engine/ASRRuntime/AppleSpeechRecognizer.swift -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>VoicePlus uses Apple's on-device speech recognizer to turn your dictation into text. Recognition stays on this Mac.</string>

	<!-- CNContactStore — Engine/Biasing/LiveProviders.swift, App/Onboarding/ContactsImport.swift -->
	<key>NSContactsUsageDescription</key>
	<string>VoicePlus reads the names in your contacts so it spells people's names correctly when you dictate them. Names never leave this Mac.</string>

	<!-- EKEventStore — Engine/Meeting/MeetingDetector.swift (macOS 14+ key) -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>VoicePlus checks your calendar for a meeting happening right now so it can offer to take notes. Event details stay on this Mac.</string>
	<!-- Legacy key, kept so older macOS releases still show a reason. -->
	<key>NSCalendarsUsageDescription</key>
	<string>VoicePlus checks your calendar for a meeting happening right now so it can offer to take notes. Event details stay on this Mac.</string>

	<!-- CoreMediaIO device enumeration (camera-in-use detection, no video is read)
	     — Engine/Meeting/MeetingDetector.swift -->
	<key>NSCameraUsageDescription</key>
	<string>VoicePlus only checks whether some other app has your camera switched on, as a hint that you are in a meeting. It never opens the camera or reads any video.</string>

	<!-- Apple Events / AX text injection — Injection/LiveSystemAccess.swift -->
	<key>NSAppleEventsUsageDescription</key>
	<string>VoicePlus sends your dictated text to whichever app you are typing into.</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>VoicePlus uses Accessibility to read your cursor position and insert dictated text into the app you are using.</string>

	<!-- NWListener loopback redirect for the "Sign in with ChatGPT" OAuth flow
	     — Providers/OAuthPKCE.swift -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>VoicePlus opens a listener on this Mac's loopback address only, to receive the sign-in redirect when you connect a cloud account. Nothing is sent over your network.</string>

	<key>SUFeedURL</key><string>https://updates.adityakatare.in/voiceplus/appcast.xml</string>
	<key>SUEnableAutomaticChecks</key><true/>
</dict>
</plist>
